{
	"name": "tota-linkedin-parser",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "bun run src/index.ts",
		"start": "bun run src/index.ts",
		"build": "bun run src/index.ts",
		"search-linkedin": "bun run src/scripts/search-linkedin-profiles.ts",
		"setup:test-data": "bun run src/scripts/setup-test-data.ts",
		"test:integration": "bun run src/scripts/test-integration.ts",
		"test:db": "bun run src/scripts/test-db-connection.ts",
		"test:rapidapi": "bun run src/scripts/test-rapidapi.ts",
		"test:mapping": "bun run src/scripts/test-data-mapping.ts",
		"test:skills": "bun run src/scripts/test-skills-processing.ts",
		"test:linking": "bun run src/scripts/test-skills-linking.ts",
		"test:data": "bun run src/scripts/test-related-data.ts",
		"test:profile": "bun run src/scripts/test-profile-update.ts",
		"test:all": "bun run test:db && bun run test:rapidapi && bun run test:mapping && bun run test:skills && bun run test:linking && bun run test:data && bun run test:profile",
		"format": "biome format --write ./src",
		"lint": "biome lint",
		"check": "biome check"
	},
	"dependencies": {
		"@t3-oss/env-core": "^0.13.8",
		"@trpc/server": "^11.4.4",
		"axios": "^1.6.0",
		"dotenv": "^17.2.1",
		"drizzle-orm": "^0.35.0",
		"pdf-parse": "^1.1.1",
		"pdf2pic": "^3.2.0",
		"pdfjs-dist": "^5.4.149",
		"pg": "^8.11.3",
		"postgres": "^3.4.4",
		"zod": "^4.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.3",
		"@types/bun": "^1.2.19",
		"@types/pg": "^8.11.0",
		"typescript": "^5.9.2"
	},
	"packageManager": "bun@1.2.19",
	"engines": {
		"node": ">=22",
		"npm": ">=11"
	}
}
